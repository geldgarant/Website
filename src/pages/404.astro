---
// 404: wordt door Cloudflare geserveerd voor elke onbekende URL (wrangler.jsonc: not_found_handling "404-page").
import Base from "../layouts/Base.astro"
import Icon from "../components/Icon.astro"
import { site } from "../data/site"

const links = [
    { t: "Incasso", d: "Zo innen we uw onbetaalde factuur", href: "/incasso" },
    { t: "Debiteurenbeheer", d: "Herinneren voordat het incasso wordt", href: "/debiteurenbeheer" },
    { t: "Tarieven", d: "Bij volledige betaling betaalt u niets", href: "/tarieven" },
    { t: "Vordering indienen", d: "In ongeveer drie minuten gestart", href: "/vordering-indienen" },
]
---

<Base
    title="Pagina niet gevonden | GeldGarant"
    description="Deze pagina bestaat niet (meer). Ga verder naar incasso, debiteurenbeheer of onze tarieven."
    noindex
>
    <section class="section nf">
        <div class="wrap nf-grid">
            <div>
                <p class="nf-code num">404</p>
                <h1 class="display nf-h1">
                    Deze pagina is <span class="accent">zoek</span>
                </h1>
                <p class="lead">
                    De link klopt niet meer of de pagina is verhuisd. Een openstaande factuur vinden we gelukkig wel. Kies
                    hieronder waar u heen wilt, of bel ons.
                </p>
                <div class="nf-actions">
                    <a class="btn" href="/">
                        Naar de homepage
                        <span class="btn-dot">
                            <Icon name="arrow" size={18} />
                        </span>
                    </a>
                    <a class="btn btn-ghost" href={site.phoneHref}>
                        <Icon name="phone" size={18} />
                        Bel{" "}
                        {site.phone}
                    </a>
                </div>
            </div>
            <ul role="list" class="nf-links">
                {links.map((l) => (
                    <li>
                        <a href={l.href}>
                            <span>
                                <strong>{l.t}</strong>
                                {l.d}
                            </span>
                            <span class="nf-go" aria-hidden="true">
                                <Icon name="arrow-up-right" size={18} />
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Base>

<style>
    .nf-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 40px;
    }
    @media (min-width: 1024px) {
        .nf-grid {
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
            gap: 80px;
            align-items: center;
        }
    }
    .nf-code {
        font-family: var(--font-display);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--blue-ink);
    }
    .nf-h1 {
        margin-top: 12px;
        font-size: clamp(2.375rem, 1.3rem + 4.2vw, 4.5rem);
    }
    .nf .lead {
        margin-top: 24px;
        max-width: 32em;
    }
    .nf-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
    }
    @media (max-width: 519px) {
        .nf-actions .btn {
            width: 100%;
        }
    }
    .nf-links {
        display: grid;
        gap: 8px;
    }
    .nf-links a {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 16px 18px 22px;
        border-radius: var(--r-lg);
        background: var(--surface);
        transition: background-color 0.2s ease;
    }
    .nf-links a:hover {
        background: var(--blue-soft);
    }
    .nf-links a > span:first-child {
        display: grid;
        flex: 1;
        gap: 2px;
        font-size: var(--fs-sm);
        color: var(--muted);
    }
    .nf-links strong {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--ink);
    }
    .nf-go {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--blue);
        color: #fff;
    }
</style>
