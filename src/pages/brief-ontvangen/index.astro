                                <Icon name="arrow" size={18} />
                            </span>
                        </button>
                        <p class="form-noot">
                            We gebruiken uw gegevens alleen voor uw dossier. Lees onze{" "}
                            <a class="textlink" href="/juridisch/privacy-beleid">
                                privacyverklaring
                            </a>
                            .
                        </p>
                    </div>
                </form>

                <div class="kaart verzonden" data-verzonden hidden>
                    <span class="verzonden-icon" aria-hidden="true">
                        <Icon name="check" size={28} />
