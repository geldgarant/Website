---
// /brief-ontvangen (stond al in header en footer van de Framer-site). Voor debiteuren: rustig, duidelijk, Wki-proof.
// Hoofdvraag: "Ik heb een brief of e-mail van GeldGarant. Wat moet ik doen?"
// Volgorde van de vragen: betalen (hero) → wat staat er in de brief (01) → hoe kan ik betalen (02)
// → regeling, al betaald, niet eens (03) → is dit echt (04) → waar mag ik op rekenen (05) → hulp en 113 (06) → vragen.
// Research 7 nov 2026: Breyta /rekening-betalen (kenmerk + bedrag via n8n en Pay.nl), Flanderijn /betalen (iDEAL/Wero,
// regeling, bezwaar, phishingbanner), GGN /ik-wil-betalen (zelf regelen, "Is dit bericht echt?"), CaseControl-portaal
// (betaallink met dossiernummer + bedrag, zonder inlog; zie src/lib/debiteur.ts).
// Wki: Regeling kwaliteit incassodienstverlening (Stcrt. 2024, 10329) art. 3 (B1, geen druk), art. 4 (manieren van
// betalen, regeling, schuldhulp, 113), art. 5 (contact, bereikbaar, fysieke afspraak); Besluit art. 3.1 (specificatie)
// en 6.1 (klachten).
import Base from "../../layouts/Base.astro"
import Icon from "../../components/Icon.astro"
import Crumbs from "../../components/Crumbs.astro"
import Veld from "../../components/form/Veld.astro"
import Faq from "../../components/Faq.astro"
import SlotCta from "../../components/SlotCta.astro"
import { site } from "../../data/site"
import { briefFaq } from "../../data/faq"
import { wikKosten, euro } from "../../lib/wik"
import { wettelijkeRente } from "../../lib/rente"
import { REDENEN, BETAAL_MIN, bedragVeld } from "../../lib/debiteur"

const title = "Brief van GeldGarant ontvangen? Direct betalen of regelen | GeldGarant"
const description =
    "Brief of e-mail van GeldGarant? Betaal direct met uw dossiernummer, vraag een betalingsregeling aan of laat weten dat u al betaalde of het niet eens bent."
const url = "https://geldgarant.com/brief-ontvangen"

// Rekenvoorbeeld voor de voorbeeldbrief (gelabeld als voorbeeld). Kosten en rente komen uit dezelfde code als de rekenhulpen.
const vb = {
    dossier: site.dossierVoorbeeld,
    opdrachtgever: "Installatiebedrijf Voorbeeld",
    debiteur: ["Bouwbedrijf Voorbeeld", "T.a.v. de directie", "Voorbeeldweg 12", "1234 AB\u00a0\u00a0VOORBEELDSTAD"],
    factuur: "2026-118",
    factuurDatum: "2 oktober 2026",
    hoofdsom: 840,
    renteVan: "2026-10-16",
    renteTot: "2026-11-06",
    briefDatum: "6 november 2026",
    uiterlijk: "17 november 2026",
}
// Zelfde opbouw als de echte aanmaning (brieven/aanmaning-1-b2b.html): zakelijke debiteur, dus wettelijke handelsrente.
const vbKosten = wikKosten(vb.hoofdsom)
const vbRente = wettelijkeRente(vb.hoofdsom, "handel", vb.renteVan, vb.renteTot).rente
const vbTotaal = Math.round((vb.hoofdsom + vbKosten + vbRente) * 100) / 100

const uitleg = [
    {
        kop: "Uw dossiernummer",
        tekst: "Uw vaste nummer bij ons. Noem het altijd: bij betalen, bellen, mailen of appen.",
    },
    {
        kop: "Namens wie wij schrijven",
        tekst: "Het bedrijf dat u een factuur stuurde. Dat heeft ons gevraagd het openstaande bedrag te innen.",
    },
    {
        kop: "Het bedrag, uitgesplitst",
        tekst: "Hoofdsom, rente en incassokosten apart. De incassokosten zijn wettelijk begrensd en hangen af van de hoofdsom.",
    },
    {
        kop: "De uiterste betaaldatum",
        tekst: "Lukt het niet voor die datum? Laat het ons dan vóór die datum weten. Dan zoeken we samen naar een oplossing.",
    },
    {
        kop: "Hoe u betaalt",
        tekst: "Online met iDEAL via de QR-code of geldgarant.com/betalen, of door over te maken met uw dossiernummer als kenmerk.",
    },
    {
        kop: "Hoe u ons bereikt",
        tekst: "Telefoon, e-mail en WhatsApp. Op werkdagen spreekt u een medewerker, die u verder helpt.",
    },
] as const

const iban = site.derdengelden.iban
const ibanNaam = site.derdengelden.tenaamstelling ?? site.name
const route = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.street}, ${site.postcode} ${site.city}`)}`

const echt = [
    {
        icon: "shield",
        kop: "Wij staan in het openbare register",
        tekst: `GeldGarant is geregistreerd bij Justis onder nummer ${site.incassoRegister}. Dat kunt u zelf controleren.`,
        link: { href: site.incassoRegisterHref, label: "Bekijk onze inschrijving", extern: true },
    },
    {
        icon: "mail",
        kop: "Onze e-mails komen van een vast adres",
        tekst: `E-mails over uw dossier komen van ${site.dossierMail}. Twijfelt u aan een afzender, stuur het bericht dan door naar ons en wij kijken mee.`,
    },
    {
        icon: "doc",
        kop: "Uw gegevens en de specificatie kloppen",
        tekst: "In onze brief staan uw dossiernummer, de naam van onze opdrachtgever en een specificatie van het bedrag. Ontbreekt iets of klopt het niet? Neem dan eerst contact met ons op.",
    },
    {
        icon: "euro",
        kop: "U betaalt alleen aan onze derdengeldenrekening",
        tekst: `Online met ${site.betaalMethode} hier op geldgarant.com, of door over te maken naar ${site.derdengelden.tenaamstelling} (${site.derdengelden.iban}). Wij vragen nooit om te betalen met een cadeaukaart, crypto of via een tussenpersoon.`,
    },
    {
        icon: "key",
        kop: "Wij vragen nooit om uw inlogcodes",
        tekst: "Niet die van uw bank, niet uw pincode en niet de code uit een sms. Vraagt iemand daarom namens GeldGarant? Stop dan en bel ons via het nummer op deze website.",
    },
] as const

const rechten = [
    {
        icon: "doc",
        kop: "Een duidelijke specificatie",
        tekst: "U ziet welk deel hoofdsom, rente en kosten is. Vraag gerust om een volledig overzicht van uw dossier.",
    },
    {
        icon: "chat",
        kop: "Duidelijke taal",
        tekst: "Wij schrijven en spreken eenvoudig Nederlands. Is iets onduidelijk, dan leggen we het uit.",
    },
    {
        icon: "phone",
        kop: "Een medewerker aan de lijn",
        tekst: `Op ${site.hours} spreekt u een medewerker, of we bellen u terug. Op e-mail krijgt u een antwoord van een mens.`,
    },
    {
        icon: "building",
        kop: "Een afspraak op kantoor",
        tekst: `Liever persoonlijk? Maak een afspraak op ons kantoor in ${site.city}, om iets te bespreken, stukken te laten zien of te betalen.`,
    },
    {
        icon: "scale",
        kop: "Geen druk of dreigementen",
        tekst: "Wij noemen alleen stappen die echt kunnen volgen, en blijven altijd zakelijk en correct.",
    },
    {
        icon: "check",
        kop: "Een klacht, eerlijk behandeld",
        tekst: "Door een andere medewerker dan uw dossierbehandelaar. Komen we er samen niet uit, dan kunt u naar IncassoKlacht.",
    },
] as const

const reken = { open: vbTotaal, maand: 100 }

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: "Brief van GeldGarant ontvangen?",
        url,
        description,
        about: { "@type": "Organization", name: site.name, telephone: site.phoneIntl, email: site.email },
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://geldgarant.com/" },
            { "@type": "ListItem", position: 2, name: "Brief ontvangen", item: url },
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: briefFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
]
---

<Base title={title} description={description} jsonLd={jsonLd} stickyCta={false}>
    <!-- HERO + BETALEN -->
    <section class="hero">
        <div class="wrap">
            <Crumbs items={[{ label: "Home", href: "/" }, { label: "Brief ontvangen" }]} />
            <div class="hero-grid">
                <div class="hero-copy">
                    <h1 class="display">
                        Brief van ons ontvangen?
                        <br />
                        Zo <span class="accent">regelt</span> u het
                    </h1>
                    <p class="lead">
                        Betaal direct met het dossiernummer uit onze brief of e-mail. Kunt u niet alles in één keer betalen, heeft
                        u al betaald of bent u het er niet mee eens? Ook dat regelt u hier.
                    </p>
                </div>

                <div class="betaal" id="betalen">
                    <div class="betaal-kop">
                        <span class="betaal-icon" aria-hidden="true">
                            <Icon name="euro" size={22} />
                        </span>
                        <div>
                            <h2 class="betaal-titel" id="betaal-titel" tabindex="-1">
                                Direct betalen
                            </h2>
                            <p class="betaal-sub">Met {site.betaalMethode}, in de vertrouwde omgeving van uw eigen bank</p>
                        </div>
                    </div>

                    <form class="betaal-form" novalidate data-betaal aria-labelledby="betaal-titel">
                        <Veld
                            id="b-dossier"
                            name="dossier"
                            label="Dossiernummer"
                            hint={`Staat bovenaan in onze brief of e-mail, bijvoorbeeld ${site.dossierVoorbeeld}.`}
                            autocomplete="off"
                            maxlength={30}
                        />
                        <Veld
                            id="b-bedrag"
                            name="bedrag"
                            label="Bedrag in euro"
                            hint={`Het totaal uit de brief, of een deel als u in delen betaalt (vanaf € ${BETAAL_MIN}).`}
                            inputmode="decimal"
                            autocomplete="off"
                            placeholder="0,00"
                            maxlength={14}
                            prefix="€"
                        />
                        <p class="melding" role="alert" data-betaal-melding hidden></p>
                        <button type="submit" class="btn betaal-knop" data-betaal-knop>
                            <span data-betaal-tekst>Betalen met {site.betaalMethode}</span>
                            <span class="btn-dot">
                                <Icon name="arrow" size={18} />
                            </span>
                        </button>
                        <p class="sr-only" role="status" data-betaal-status></p>
                    </form>

                    <ol role="list" class="betaal-stappen" aria-label="Zo werkt direct betalen">
                        <li>
                            <span class="betaal-nr" aria-hidden="true">
                                1
                            </span>
                            Vul uw dossiernummer en het bedrag in
                        </li>
                        <li>
                            <span class="betaal-nr" aria-hidden="true">
                                2
                            </span>
                            Betaal met {site.betaalMethode} in uw eigen bank-app
                        </li>
                        <li>
                            <span class="betaal-nr" aria-hidden="true">
                                3
                            </span>
                            Wij boeken de betaling automatisch op uw dossier
                        </li>
                    </ol>

                    <div class="betaal-alt" data-betaal-alt hidden>
                        <p class="betaal-alt-kop" tabindex="-1" data-betaal-alt-kop>
                            Online betalen lukt op dit moment niet
                        </p>
                        <p class="betaal-alt-tekst">
                            Probeer het over een paar minuten opnieuw. U kunt het bedrag ook nu overmaken, met deze gegevens:
                        </p>
                        <dl class="betaal-alt-gegevens">
                            <div>
                                <dt>IBAN</dt>
                                <dd class="num">{iban}</dd>
                            </div>
                            <div>
                                <dt>Ten name van</dt>
                                <dd>{ibanNaam}</dd>
                            </div>
                            <div>
                                <dt>Kenmerk</dt>
                                <dd class="num" data-alt-waarde="dossier"></dd>
                            </div>
                            <div>
                                <dt>Bedrag</dt>
                                <dd class="num" data-alt-waarde="bedrag"></dd>
                            </div>
                        </dl>
                        <button type="button" class="btn btn-dark betaal-knop" data-opnieuw>
                            Opnieuw proberen
                        </button>
                    </div>

                    <ul role="list" class="betaal-vertrouwen">
                        <li>
                            <Icon name="shield" size={16} />
                            Beveiligd betalen met {site.betaalMethode}
                        </li>
                        <li>
                            <Icon name="check" size={16} />
                            Geregistreerd bij Justis, nr.{"\u00a0"}
                            {site.incassoRegister}
                        </li>
                    </ul>
                </div>
                <ul role="list" class="snel" aria-label="Wat wilt u doen?">
                    <li>
                        <a href="#regelen" data-kies-reden="regeling">
                            <span class="snel-icon" aria-hidden="true">
                                <Icon name="calendar" size={20} />
                            </span>
                            In termijnen betalen
                        </a>
                    </li>
                    <li>
                        <a href="#regelen" data-kies-reden="betaald">
                            <span class="snel-icon" aria-hidden="true">
                                <Icon name="check" size={20} />
                            </span>
                            Ik heb al betaald
                        </a>
                    </li>
                    <li>
                        <a href="#regelen" data-kies-reden="oneens">
                            <span class="snel-icon" aria-hidden="true">
                                <Icon name="scale" size={20} />
                            </span>
                            Ik ben het niet eens
                        </a>
                    </li>
                    <li>
                        <a href="#echt">
                            <span class="snel-icon" aria-hidden="true">
                                <Icon name="shield" size={20} />
                            </span>
                            Is deze brief echt?
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- 01 DE BRIEF UITGELEGD -->
    <section class="section bg-surface" id="uitleg" aria-labelledby="uitleg-title">
        <div class="wrap">
            <div class="kop">
                <p class="eyebrow">
                    <span class="idx">01</span> Uw brief
                </p>
                <h2 class="h2" id="uitleg-title">
                    Wat er in onze brief <span class="accent">staat</span>
                </h2>
                <p class="lead">
                    Elke brief van ons bevat dezelfde onderdelen. Zo vindt u snel wat u nodig heeft, ook in een e-mail of sms.
                </p>
            </div>

            <div class="brief-grid">
                <figure class="brief" aria-labelledby="brief-label">
                    <p class="brief-label" id="brief-label">
                        Voorbeeldbrief
                    </p>
                    <div class="brief-papier">
                        <div class="brief-top">
                            <img src="/brand/full-logo-light.svg" alt="GeldGarant" width="150" height="24" class="brief-logo" />
                            <p class="brief-afz">
                                {site.street}
                                <br />
                                {`${site.postcode} ${site.city}`}
                                <br />
                                {site.phone}
                            </p>
                        </div>
                        <div class="brief-kop">
                            <p class="brief-adres">
                                <span class="brief-retour">
                                    Retour: GeldGarant, {site.street}, {site.city}
                                </span>
                                {vb.debiteur.map((r) => (
                                    <>
                                        {r}
                                        <br />
                                    </>
                                ))}
                            </p>
                            <dl class="brief-meta">
                                <div>
                                    <dt>Datum</dt>
                                    <dd>{vb.briefDatum}</dd>
                                </div>
                                <div>
                                    <dt>Dossiernummer</dt>
                                    <dd class="num">
                                        {vb.dossier}
                                        <span class="m" aria-hidden="true">
                                            1
                                        </span>
                                    </dd>
                                </div>
                                <div>
                                    <dt>Namens</dt>
                                    <dd>
                                        {vb.opdrachtgever}
                                        <span class="m" aria-hidden="true">
                                            2
                                        </span>
                                    </dd>
                                </div>
                                <div>
                                    <dt>Betalen uiterlijk</dt>
                                    <dd>
                                        {vb.uiterlijk}
                                        <span class="m" aria-hidden="true">
                                            4
                                        </span>
                                    </dd>
                                </div>
                            </dl>
                        </div>
                        <div>
                            <p class="brief-eyebrow">Aanmaning</p>
                            <p class="brief-titel">Uw betaling aan {vb.opdrachtgever} staat nog open</p>
                        </div>
                        <p>Geachte directie,</p>
                        <p>
                            {vb.opdrachtgever} heeft GeldGarant gevraagd de betaling van de factuur hieronder te regelen. De
                            betaaltermijn is verstreken en wij hebben nog geen betaling ontvangen.
                        </p>
                        <dl class="brief-band">
                            <div>
                                <dt>Totaal te betalen</dt>
                                <dd class="num">
                                    {euro(vbTotaal)}
                                    <span class="m" aria-hidden="true">
                                        3
                                    </span>
                                </dd>
                            </div>
                            <div>
                                <dt>Uiterlijk op</dt>
                                <dd>{vb.uiterlijk}</dd>
                            </div>
                            <div>
                                <dt>Betalingskenmerk</dt>
                                <dd class="num">{vb.dossier}</dd>
                            </div>
                        </dl>
                        <p class="brief-h">Specificatie</p>
                        <table class="spec">
                            <caption class="sr-only">Specificatie van het voorbeeldbedrag</caption>
                            <tbody>
                                <tr>
                                    <th scope="row">
                                        Factuur {vb.factuur} van {vb.factuurDatum}
                                    </th>
                                    <td class="num">{euro(vb.hoofdsom)}</td>
                                </tr>
                                <tr>
                                    <th scope="row">Wettelijke handelsrente tot en met {vb.briefDatum}</th>
                                    <td class="num">{euro(vbRente)}</td>
                                </tr>
                                <tr>
                                    <th scope="row">Incassokosten (wettelijke staffel)</th>
                                    <td class="num">{euro(vbKosten)}</td>
                                </tr>
                                <tr class="spec-totaal">
                                    <th scope="row">Totaal te betalen</th>
                                    <td class="num">{euro(vbTotaal)}</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="brief-h">
                            Zo betaalt u
                            <span class="m" aria-hidden="true">
                                5
                            </span>
                        </p>
                        <div class="brief-betaal">
                            <div class="brief-betaal-ideal">
                                <img src="/brief/qr-betalen.png" alt="" width="58" height="58" loading="lazy" />
                                <p>
                                    <strong>Online met {site.betaalMethode}</strong>
                                    <br />
                                    geldgarant.com/betalen
                                </p>
                            </div>
                            <p>
                                <strong>Overmaken</strong>
                                <br />
                                <span class="num">{iban}</span>
                                <br />
                                Kenmerk <span class="num">{vb.dossier}</span>
                            </p>
                        </div>
                        <p>
                            Kunt u niet in één keer betalen, of bent u het er niet mee eens? Neem dan vóór {vb.uiterlijk} contact
                            met ons op
                            <span class="m" aria-hidden="true">
                                6
                            </span>
                            . Wij denken graag met u mee.
                        </p>
                        <p class="brief-groet">
                            Met vriendelijke groet,
                            <br />
                            <strong>GeldGarant</strong>, afdeling incasso
                        </p>
                    </div>
                    <figcaption>
                        Zo ziet onze aanmaning eruit, met verzonnen namen en een rekenvoorbeeld bij een hoofdsom van{" "}
                        {euro(vb.hoofdsom)}. In uw eigen brief staan uw gegevens en uw bedragen, op dezelfde plek.
                    </figcaption>
                </figure>

                <ol role="list" class="uitleg">
                    {uitleg.map((u, i) => (
                        <li>
                            <span class="m m-groot" aria-hidden="true">
                                {i + 1}
                            </span>
                            <div>
                                <h3 class="uitleg-kop">{u.kop}</h3>
                                <p>{u.tekst}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </div>
    </section>

    <!-- 02 ZO BETAALT U -->
    <section class="section" aria-labelledby="manieren-title">
        <div class="wrap">
            <div class="kop">
                <p class="eyebrow">
                    <span class="idx">02</span> Betalen
                </p>
                <h2 class="h2" id="manieren-title">
                    Drie manieren om te <span class="accent">betalen</span>
                </h2>
                <p class="lead">
                    Kies wat u het prettigst vindt. Vermeld altijd uw dossiernummer, dan komt uw betaling goed terecht.
                </p>
            </div>
            <ul role="list" class="manieren">
                <li class="manier manier-hoofd">
                    <span class="manier-icon" aria-hidden="true">
                        <Icon name="bolt" size={22} />
                    </span>
                    <h3 class="h3">Online, direct</h3>
                    <p>
                        Met uw dossiernummer en het bedrag. U betaalt met {site.betaalMethode}, in de vertrouwde omgeving van uw
                        eigen bank.
                    </p>
                    <a class="btn manier-btn" href="#betalen" data-naar-betalen>
                        Direct betalen
                        <span class="btn-dot">
                            <Icon name="arrow" size={18} />
                        </span>
                    </a>
                </li>
                <li class="manier">
                    <span class="manier-icon" aria-hidden="true">
                        <Icon name="bank" size={22} />
                    </span>
                    <h3 class="h3">Overmaken</h3>
                    {iban ? (
                        <>
                            <p>Via uw eigen bank, naar onze derdengeldenrekening.</p>
                            <dl class="bank">
                                <div>
                                    <dt>IBAN</dt>
                                    <dd class="num">{iban}</dd>
                                </div>
                                <div>
                                    <dt>Ten name van</dt>
                                    <dd>{ibanNaam}</dd>
                                </div>
                                <div>
                                    <dt>BIC</dt>
                                    <dd class="num">{site.derdengelden.bic}</dd>
                                </div>
                                <div>
                                    <dt>Kenmerk</dt>
                                    <dd>Uw dossiernummer</dd>
                                </div>
                            </dl>
                        </>
                    ) : (
                        <p>
                            Via uw eigen bank. Het rekeningnummer staat in onze brief. Gebruik uw dossiernummer als
                            betalingskenmerk, zonder kenmerk kunnen we uw betaling niet koppelen.
                        </p>
                    )}
                    <a class="textlink manier-link manier-onder" href="#uitleg">
                        Waar staat wat in de brief?
                    </a>
                </li>
                <li class="manier">
                    <span class="manier-icon" aria-hidden="true">
                        <Icon name="building" size={22} />
                    </span>
                    <h3 class="h3">Op ons kantoor</h3>
                    <p>
                        Liever persoonlijk? Maak een afspraak op ons kantoor aan de {site.street} in {site.city}. Dan bespreken we
                        alles aan tafel.
                    </p>
                    <div class="manier-acties">
                        <a class="btn btn-ghost manier-btn" href={site.phoneHref}>
                            Bel{"\u00a0"}voor{"\u00a0"}een{"\u00a0"}afspraak
                        </a>
                        <a class="textlink manier-link" href={route} target="_blank" rel="noopener">
                            Route
                            <Icon name="arrow-up-right" size={15} />
