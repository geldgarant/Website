        padding-bottom: 14px;
        border-bottom: 1px solid var(--line);
    }
    .brief-logo {
        width: 132px;
        height: auto;
    }
    .brief-afz {
        font-size: var(--fs-xs);
        line-height: 1.5;
        color: var(--muted);
        text-align: right;
    }
    .brief-kop {
        display: grid;
        gap: 14px;
    }
    @media (min-width: 640px) {
        .brief-kop {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
            gap: 24px;
            align-items: start;
        }
    }
    .brief-adres {
        font-size: var(--fs-sm);
        line-height: 1.55;
    }
    .brief-retour {
        display: block;
        margin-bottom: 4px;
        font-size: 0.6875rem;
        color: var(--muted);
    }
    .brief-meta {
        display: grid;
        font-size: var(--fs-xs);
    }
    .brief-meta > div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 5px 0;
        border-bottom: 1px solid var(--line);
    }
    .brief-meta > div:last-child {
        border-bottom: 0;
    }
    .brief-meta dt {
        color: var(--muted);
    }
    .brief-meta dd {
        font-weight: 600;
        text-align: right;
    }
    .brief-eyebrow {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--blue-ink);
    }
    .brief-titel {
        margin-top: 2px;
        font-family: var(--font-display);
        font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.01em;
    }
    .brief-band {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
        border-radius: var(--r-sm, 8px);
        background: var(--ink);
        color: #fff;
        overflow: hidden;
    }
    .brief-band > div {
        padding: 10px 14px;
        box-shadow: -1px 0 0 rgba(255, 255, 255, 0.14);
    }
    .brief-band dt {
        font-size: 0.6875rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #b9c3dc;
    }
    .brief-band dd {
        font-weight: 700;
        line-height: 1.4;
    }
    .brief-band .m {
        background: #fff;
        color: var(--blue-ink);
    }
    .brief-h {
        margin-bottom: -6px;
        font-family: var(--font-display);
        font-weight: 600;
    }
    .brief-betaal {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 10px;
        font-size: var(--fs-xs);
        line-height: 1.55;
    }
    .brief-betaal > * {
        padding: 10px 12px;
        border-radius: var(--r-sm, 8px);
        background: var(--surface);
    }
    .brief-betaal-ideal {
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: inset 2px 0 0 var(--blue);
    }
    .brief-betaal-ideal img {
        flex-shrink: 0;
        width: 58px;
        height: 58px;
    }
    .spec {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--fs-sm);
    }
    .spec th,
    .spec td {
        padding: 8px 0;
        border-bottom: 1px solid var(--line);
        font-weight: 400;
        text-align: left;
        vertical-align: top;
    }
    .spec td {
        padding-left: 12px;
        text-align: right;
        white-space: nowrap;
    }
    .spec-totaal th,
    .spec-totaal td {
        border-bottom: 0;
        font-weight: 700;
    }
    .brief-groet {
        margin-top: 4px;
    }
    .m {
        display: inline-grid;
        place-items: center;
        min-width: 20px;
        height: 20px;
        margin-left: 3px;
        padding: 0 5px;
        border-radius: var(--r-pill);
        background: var(--blue);
        color: #fff;
        font-family: var(--font-body);
        font-size: 0.6875rem;
        font-weight: 700;
        line-height: 1;
        vertical-align: 2px;
    }
    .brief figcaption {
        margin-top: 12px;
        font-size: var(--fs-xs);
        color: var(--muted);
    }
    .uitleg {
        display: grid;
        gap: 10px;
    }
    .uitleg li {
        display: grid;
        grid-template-columns: 32px minmax(0, 1fr);
        gap: 14px;
        padding: 16px 18px;
        border-radius: var(--r-lg);
        background: #fff;
    }
    .m-groot {
        min-width: 32px;
        height: 32px;
        margin: 0;
        font-size: var(--fs-xs);
        vertical-align: baseline;
    }
    .uitleg-kop {
        font-family: var(--font-display);
        font-size: 1.0625rem;
        font-weight: 600;
        color: var(--ink);
    }
    .uitleg p {
        margin-top: 4px;
        font-size: var(--fs-sm);
        line-height: 1.55;
        color: var(--text);
    }

    /* ---------- 02 MANIEREN ---------- */
    .manieren {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }
    @media (min-width: 900px) {
        .manieren {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }
    }
    .manier {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: clamp(22px, 2.6vw, 32px);
        border-radius: var(--r-xl);
        background: var(--surface);
    }
    .manier p {
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: var(--text);
    }
    .manier-hoofd {
        background: var(--ink);
    }
    .manier-hoofd .h3 {
        color: #fff;
    }
    .manier-hoofd p {
        color: rgba(255, 255, 255, 0.78);
    }
    .manier-icon {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        margin-bottom: 8px;
        border-radius: 50%;
        background: #fff;
        color: var(--blue);
    }
    .manier-btn {
        align-self: flex-start;
        margin-top: auto;
    }
    .manier .btn-ghost {
        --btn-bg: #fff;
    }
    .manier-onder {
        align-self: flex-start;
        margin-top: auto;
    }
    .manier-acties {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 18px;
        margin-top: auto;
    }
    .manier-acties .manier-btn {
        margin-top: 0;
    }
    .manier-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        font-size: var(--fs-sm);
        font-weight: 600;
    }
    .bank {
        display: grid;
        gap: 2px;
        margin-top: auto;
        padding: 12px 16px;
        border-radius: var(--r-md);
        background: #fff;
        font-size: var(--fs-sm);
    }
    .bank > div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 0;
    }
    .bank dt {
        color: var(--muted);
    }
    .bank dd {
        font-weight: 600;
        color: var(--ink);
        text-align: right;
    }
    .noot {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 24px;
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: var(--text);
    }
    .noot :global(svg) {
        flex-shrink: 0;
        margin-top: 3px;
        color: var(--blue);
    }

    /* ---------- 03 REGELEN ---------- */
    .regelen {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas:
            "kop"
            "form"
            "zij";
        gap: 0 clamp(32px, 5vw, 72px);
    }
    @media (min-width: 1024px) {
        .regelen {
            grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
            grid-template-areas:
                "kop form"
                "zij form";
            align-items: start;
        }
    }
    .regelen-kop {
        grid-area: kop;
    }
    .regelen-zij {
        grid-area: zij;
        display: grid;
        gap: 16px;
        margin-top: 24px;
    }
    @media (min-width: 1024px) {
        .regelen-zij {
            margin-top: 0;
        }
    }
    .regelen-form {
        grid-area: form;
        min-width: 0;
    }
    .reken {
        padding: clamp(20px, 2.6vw, 28px);
        border-radius: var(--r-xl);
        background: #fff;
    }
    .reken-kop {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--ink);
    }
    .reken-velden {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 12px;
        margin-top: 14px;
    }
    .reken-uit {
        padding: 14px 16px;
        border-radius: var(--r-md);
        background: var(--blue-soft);
        font-size: var(--fs-sm);
        line-height: 1.5;
        color: var(--ink);
    }
    .reken-uit :global(strong) {
        font-weight: 700;
    }
    .reken-neem {
        width: 100%;
        margin-top: 12px;
    }
    .reken-noot {
        margin-top: 10px;
        font-size: var(--fs-xs);
        color: var(--muted);
    }
    .stappen {
        display: grid;
        gap: 4px;
    }
    .stappen li {
        display: grid;
        grid-template-columns: 32px minmax(0, 1fr);
        gap: 14px;
        padding: 14px 4px;
    }
    .stap-nr {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--ink);
        color: #fff;
        font-size: var(--fs-xs);
        font-weight: 700;
    }
    .stap-kop {
        font-family: var(--font-display);
        font-size: 1.0625rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--ink);
    }
    .stappen p {
        margin-top: 4px;
        font-size: var(--fs-sm);
        line-height: 1.55;
        color: var(--text);
    }

    .kaart {
        padding: clamp(20px, 3.4vw, 40px);
        border-radius: var(--r-xl);
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-card);
    }
    .form-kop {
        margin-bottom: 18px;
        font-family: var(--font-display);
        font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--ink);
        outline: none;
    }
    .velden {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0 16px;
    }
    @media (min-width: 640px) {
        .velden {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
    }
    .velden .breed {
        grid-column: 1 / -1;
    }
    .keuzes,
    .voorkeur {
        min-width: 0;
        margin: 0 0 18px;
        padding: 0;
        border: 0;
    }
    .voorkeur legend {
        margin-bottom: 10px;
        padding: 0;
    }
    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .chips label,
    .mini-seg label {
        position: relative;
    }
    .chips input,
    .mini-seg input {
        position: absolute;
        inset: 0;
        opacity: 0;
        margin: 0;
        cursor: pointer;
    }
    .chips span {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 16px;
        border: 1.5px solid var(--line);
        border-radius: var(--r-pill);
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--ink);
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease,
            color 0.15s ease;
    }
    .chips label:hover span {
        border-color: #b9c0d0;
    }
    .chips input:checked + span {
        border-color: var(--ink);
        background: var(--ink);
        color: #fff;
    }
    .chips input:focus-visible + span,
    .mini-seg input:focus-visible + span {
        outline: 2.5px solid var(--blue);
        outline-offset: 2px;
    }
    .mini-seg {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 4px;
        padding: 4px;
        border-radius: var(--r-md);
        background: var(--surface);
    }
    .mini-seg span {
        display: grid;
        place-items: center;
        min-height: 44px;
        border-radius: 10px;
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--text);
    }
    .mini-seg input:checked + span {
        background: #fff;
        color: var(--ink);
        box-shadow: 0 1px 3px rgba(6, 17, 38, 0.12);
    }
    .vink {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 44px;
        margin-bottom: 16px;
        font-size: var(--fs-sm);
        color: var(--ink);
        cursor: pointer;
    }
    .vink input {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
        margin: 0;
        accent-color: var(--blue);
    }
    .vink:has(input:focus-visible) {
        outline: 2.5px solid var(--blue);
        outline-offset: 2px;
        border-radius: 6px;
    }
    .regelen-form :global(.veld textarea) {
        min-height: 110px;
    }
    .turnstile:empty {
        display: none;
    }
    .turnstile {
        margin-bottom: 12px;
    }
    :global(.melding) {
        margin: 0 0 16px;
        padding: 12px 14px;
        border-radius: var(--r-md);
        font-size: var(--fs-sm);
        line-height: 1.5;
        background: #fdecea;
        color: #8a1c12;
    }
    :global(.melding[data-soort="let-op"]) {
        background: #fff4e0;
        color: #6b4500;
    }
    .form-voet {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 20px;
        padding-top: 20px;
        border-top: 1px solid var(--line);
    }
    .form-voet .btn[aria-busy="true"] {
        opacity: 0.7;
        cursor: progress;
    }
    .form-noot {
        flex: 1;
        min-width: 220px;
        font-size: var(--fs-xs);
        color: var(--muted);
        line-height: 1.5;
    }
    @media (max-width: 519px) {
        .form-voet .btn {
            width: 100%;
            justify-content: space-between;
        }
    }
    .verzonden-icon {
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--green-bg);
        color: var(--green);
    }
    .verzonden-kop {
        margin-top: 20px;
        outline: none;
    }
    .verzonden .lead {
        margin-top: 14px;
    }
    .verzonden-noot {
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: var(--r-md);
        background: #fff4e0;
        color: #6b4500;
        font-size: var(--fs-sm);
    }

    /* ---------- 04 ECHT ---------- */
    .echt {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 32px clamp(32px, 5vw, 72px);
    }
    @media (min-width: 1024px) {
        .echt {
            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
            align-items: start;
        }
    }
    .echt-kop {
        margin-bottom: 0;
    }
    .twijfel {
        margin-top: 28px;
        padding: clamp(20px, 2.6vw, 28px);
        border-radius: var(--r-xl);
    }
    .twijfel-kop {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        color: #fff;
    }
    .twijfel p:not(.twijfel-kop) {
        margin-top: 6px;
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.8);
    }
    .twijfel .btn {
        margin-top: 18px;
    }
    .checks {
        display: grid;
        gap: 12px;
    }
    .check {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 16px;
        padding: clamp(18px, 2.4vw, 26px);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
    }
    .check-icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--green-bg);
        color: var(--green);
    }
    .check-kop {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--ink);
    }
    .check p {
        margin-top: 6px;
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: var(--text);
    }
    .check-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        font-size: var(--fs-sm);
        font-weight: 600;
    }

    /* ---------- 05 RECHTEN ---------- */
    .rechten {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 80%);
        gap: 12px;
        margin-inline: calc(var(--gutter) * -1);
        padding-inline: var(--gutter);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--gutter);
        scrollbar-width: none;
    }
    .rechten > li {
        scroll-snap-align: start;
    }
    @media (min-width: 720px) {
        .rechten {
            grid-auto-flow: row;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
            margin-inline: 0;
            padding-inline: 0;
            overflow: visible;
        }
    }
    @media (min-width: 1100px) {
        .rechten {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    .recht {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: clamp(22px, 2.6vw, 30px);
        border-radius: var(--r-xl);
        background: #fff;
    }
    .recht-icon {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 6px;
        border-radius: 50%;
        background: var(--blue-soft);
        color: var(--blue);
    }
    .recht-kop {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--ink);
    }
    .recht p {
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: var(--text);
    }
    .rechten-links {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 28px;
        margin-top: 24px;
        font-size: var(--fs-sm);
        font-weight: 600;
    }
    .rechten-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
    }

    /* ---------- 06 HULP ---------- */
    .hulp {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }
    @media (min-width: 900px) {
        .hulp {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
    }
    .hulp-kaart {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: clamp(24px, 3.4vw, 44px);
        border-radius: var(--r-xl);
        background: var(--surface);
    }
    .hulp-113 {
        background: var(--blue-soft);
    }
    .hulp-icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        margin-bottom: 6px;
        border-radius: 50%;
        background: #fff;
        color: var(--blue);
    }
    .hulp-kop {
        font-family: var(--font-display);
        font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.2;
        color: var(--ink);
    }
    .hulp-kaart p {
        max-width: 34em;
        line-height: 1.65;
        color: var(--text);
    }
    .hulp-acties {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
        margin-top: auto;
        padding-top: 10px;
    }
    .hulp-acties .btn-ghost {
        --btn-bg: #fff;
    }
    .hulp-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-size: var(--fs-sm);
        font-weight: 600;
    }

    /* ---------- mobiele actiebalk ---------- */
    .actiebalk {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        z-index: 40;
        display: flex;
        gap: 8px;
        padding: 8px;
        border-radius: var(--r-pill);
        background: rgba(6, 17, 38, 0.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 16px 32px -12px rgba(6, 17, 38, 0.5);
        transform: translateY(calc(100% + 24px));
        transition: transform 0.35s var(--ease);
    }
    .actiebalk.is-visible {
        transform: none;
    }
    :global(html.menu-open) .actiebalk {
        display: none;
    }
    @media (min-width: 1080px) {
        .actiebalk {
            display: none;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .actiebalk {
            transition: none;
        }
    }
    .actiebalk-main {
