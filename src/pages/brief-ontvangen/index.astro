                            name="betaald_bedrag"
                            label="Bedrag"
                            inputmode="decimal"
                            placeholder="0,00"
                            maxlength={12}
                        />
                    </div>

                    <div class="velden">
                        <Veld id="r-email" name="email" label="E-mail" type="email" autocomplete="email" />
                        <Veld id="r-telefoon" name="telefoon" label="Telefoon" type="tel" autocomplete="tel" optioneel />
                    </div>

                    <fieldset class="voorkeur">
                        <legend class="veld-label">Hoe wilt u antwoord?</legend>
                        <div class="mini-seg">
                            <label>
                                <input type="radio" name="voorkeur" value="email" data-bind="voorkeur" checked />
                                <span>E-mail</span>
                            </label>
                            <label>
                                <input type="radio" name="voorkeur" value="telefoon" data-bind="voorkeur" />
                                <span>Bellen</span>
                            </label>
                            <label>
                                <input type="radio" name="voorkeur" value="whatsapp" data-bind="voorkeur" />
                                <span>WhatsApp</span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="veld" data-veld="toelichting">
                        <label for="r-toelichting">
                            <span data-label-voor="standaard">
                                Toelichting <span class="veld-opt">optioneel</span>
                            </span>
                            <span data-label-voor="oneens" hidden>
                                Waarom bent u het niet eens?
                            </span>
                            <span data-label-voor="anders" hidden>
                                Uw vraag
                            </span>
                        </label>
                        <textarea
                            id="r-toelichting"
                            name="toelichting"
                            rows="4"
                            maxlength="1500"
                            aria-describedby="r-toelichting-fout"
