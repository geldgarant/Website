---
// /juridisch: overzicht van de juridische documenten (nieuw; bestond in Framer niet, wel als kruimelpad-niveau).
// Hoofdvraag: "Waar vind ik jullie voorwaarden, privacy- en klachtenregels?" Eén blik, vier documenten.
import Base from "../../layouts/Base.astro"
import Icon from "../../components/Icon.astro"
import Crumbs from "../../components/Crumbs.astro"
import { site } from "../../data/site"
import { juridisch } from "../../data/juridisch"

const title = "Juridische documenten | GeldGarant"
const description =
    "Algemene voorwaarden, privacyverklaring, cookieverklaring en klachtenregeling van GeldGarant op één plek. Online te lezen en als pdf te downloaden."
const url = "https://geldgarant.com/juridisch"

const kaarten = [
    ...juridisch.map((d) => ({
        href: `/juridisch/${d.slug}`,
        titel: d.naam,
        voor: d.voor,
        tekst: d.lead.split(". ")[0].replace(/\.$/, "") + ".",
        preview: `/juridisch/${d.preview}`,
    })),
    {
        href: "/klachtenregelement",
        titel: "Klachtenregeling",
        voor: "Voor iedereen",
        tekst: "Hoe u een klacht indient, wat er daarna gebeurt en wanneer u antwoord krijgt.",
        preview: "",
    },
]

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: title,
        url,
        description,
        mainEntity: {
            "@type": "ItemList",
            itemListElement: kaarten.map((k, i) => ({
                "@type": "ListItem",
                position: i + 1,
                name: k.titel,
                url: `https://geldgarant.com${k.href}`,
            })),
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://geldgarant.com/" },
            { "@type": "ListItem", position: 2, name: "Juridisch", item: url },
        ],
    },
]
---

<Base title={title} description={description} jsonLd={jsonLd} stickyCta={false}>
    <section class="hero">
        <div class="wrap">
            <Crumbs items={[{ label: "Home", href: "/" }, { label: "Juridisch" }]} />
            <h1 class="display">
                Juridische <span class="accent">documenten</span>
            </h1>
            <p class="lead">
                Onze voorwaarden en regelingen op één plek. Duidelijk over wat u van ons mag verwachten, en wat wij van u vragen.{" "}
                {site.name} is geregistreerd bij Justis onder nummer {site.incassoRegister}.
            </p>
        </div>
    </section>

    <section class="section docs-sec" aria-label="Documenten">
        <div class="wrap">
            <ul role="list" class="docs">
                {kaarten.map((k, i) => (
                    <li data-reveal style={`--d:${i}`}>
                        <a class="doc" href={k.href}>
                            <span class="doc-blad" aria-hidden="true">
                                {k.preview ? (
                                    <img
                                        src={k.preview}
                                        alt=""
                                        width="600"
                                        height="849"
                                        loading={i < 2 ? "eager" : "lazy"}
                                        decoding="async"
                                    />
                                ) : (
                                    <span class="doc-blad-leeg">
                                        <Icon name="scale" size={30} />
                                        <span class="leeg-titel">Klachtenregeling</span>
                                        <span class="leeg-regel"></span>
                                        <span class="leeg-regel kort"></span>
                                        <span class="leeg-regel"></span>
                                    </span>
                                )}
                            </span>
                            <span class="doc-voor">{k.voor}</span>
                            <span class="doc-titel">{k.titel}</span>
                            <span class="doc-tekst">{k.tekst}</span>
                            <span class="doc-meer">
                                Bekijken
                                <Icon name="arrow" size={16} />
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>
</Base>

<style>
    .hero {
        padding-block: clamp(20px, 3vw, 40px) clamp(40px, 5vw, 64px);
    }
    .hero h1 {
        margin-top: clamp(24px, 3vw, 40px);
        font-size: clamp(2.375rem, 1.3rem + 4.2vw, 4.5rem);
    }
    .hero .lead {
        margin-top: 24px;
        max-width: 38em;
    }
    .docs-sec {
        padding-top: 0;
    }
    .docs {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
    }
    @media (min-width: 640px) {
        .docs {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (min-width: 1100px) {
        .docs {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
    .doc {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px 16px 22px;
        border-radius: var(--r-xl);
        background: var(--surface);
        color: var(--ink);
        transition: background 0.2s;
    }
    .doc:hover {
        background: var(--blue-soft);
    }
    .doc-blad {
        display: block;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        margin-bottom: 20px;
        border-radius: var(--r-lg);
        background: #e8ebf2;
    }
    .doc-blad img {
        display: block;
        width: 78%;
        height: auto;
        margin: 18px auto 0;
        border-radius: 6px;
        box-shadow:
            0 1px 2px rgba(6, 17, 38, 0.08),
            0 12px 28px rgba(6, 17, 38, 0.12);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .doc:hover .doc-blad img {
            transform: translateY(-6px);
        }
    }
    /* klachtenregeling heeft geen pdf: een getekend blad in dezelfde stijl */
    .doc-blad-leeg {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 78%;
        height: 100%;
        margin: 18px auto 0;
        padding: 22px 20px;
        border-radius: 6px;
        background: #fff;
        color: var(--blue);
        box-shadow:
            0 1px 2px rgba(6, 17, 38, 0.08),
            0 12px 28px rgba(6, 17, 38, 0.12);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .leeg-titel {
        margin-top: 4px;
        font-family: var(--font-display);
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--ink);
    }
    .leeg-regel {
        height: 6px;
        border-radius: 3px;
        background: var(--line);
    }
    .leeg-regel.kort {
        width: 60%;
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .doc:hover .doc-blad-leeg {
            transform: translateY(-6px);
        }
    }
    .doc-voor {
        padding-inline: 8px;
        font-size: var(--fs-xs);
        font-weight: 600;
        color: var(--blue-ink);
    }
    .doc-titel {
        margin-top: 6px;
        padding-inline: 8px;
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.25;
    }
    .doc-tekst {
        margin-top: 8px;
        padding-inline: 8px;
        font-size: var(--fs-sm);
        line-height: 1.55;
        color: var(--text);
    }
    .doc-meer {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        margin-top: auto;
        padding: 12px 8px 0;
        font-size: var(--fs-sm);
        font-weight: 600;
    }
    .doc-meer :global(svg) {
        color: var(--blue);
    }
</style>
