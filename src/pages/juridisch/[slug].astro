---
// /juridisch/algemene-voorwaarden, /juridisch/privacy-beleid en /juridisch/cookie-beleid (slugs uit Framer).
// Hoofdvraag: "Wat spreken we af, en waar staat wat ik zoek?" De HTML is de leidende tekst; de pdf wordt daaruit
// gemaakt (scripts/juridisch-pdf.mjs, printopmaak hieronder), zodat beide altijd gelijk zijn.
// Volgorde: wat is dit en download (hero) → in het kort → volledige tekst met meelopende inhoudsopgave → andere documenten.
// Tekst: src/content/juridisch/<slug>.md. Nabewerking (plaatshouders, staffel, ankers): src/lib/juridisch.ts.
import { getCollection } from "astro:content"
import Base from "../../layouts/Base.astro"
import "../../styles/artikel.css"
import Icon from "../../components/Icon.astro"
import Crumbs from "../../components/Crumbs.astro"
import { site } from "../../data/site"
import { VOLGORDE, pdfInfo, type DocSlug } from "../../data/juridisch"
import { bewerkJuridischHtml } from "../../lib/juridisch"
import { platteTekst } from "../../lib/artikel"
import { leestijd } from "../../data/kennisbank"

export async function getStaticPaths() {
    const docs = await getCollection("juridisch")
    return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }))
}

const { doc } = Astro.props
const d = doc.data
const slug = doc.id as DocSlug
const pdf = pdfInfo(slug)
const pdfHref = `/juridisch/${pdf.bestand}`
const { html, koppen } = bewerkJuridischHtml(doc.rendered?.html ?? "")
const minuten = leestijd(platteTekst(html))
const isAv = slug === "algemene-voorwaarden"

const url = `https://geldgarant.com/juridisch/${slug}`
const datum = new Intl.DateTimeFormat("nl-NL", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
    d.versie,
)
const versieIso = d.versie.toISOString().slice(0, 10)

const alle = await getCollection("juridisch")
const anderen = [
    ...VOLGORDE.filter((s) => s !== slug).map((s) => {
        const a = alle.find((x) => x.id === s)!
        return { href: `/juridisch/${s}`, titel: a.data.naam, tekst: a.data.voor, icon: "doc" as const }
    }),
    { href: "/klachtenregelement", titel: "Klachtenregeling", tekst: "Voor iedereen", icon: "scale" as const },
]

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: d.seoTitle,
        url,
        description: d.description,
        dateModified: versieIso,
        inLanguage: "nl-NL",
        publisher: { "@type": "Organization", name: site.name, url: "https://geldgarant.com" },
        associatedMedia: {
            "@type": "MediaObject",
            name: `${d.naam} GeldGarant (pdf)`,
            contentUrl: `https://geldgarant.com${pdfHref}`,
            encodingFormat: "application/pdf",
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://geldgarant.com/" },
            { "@type": "ListItem", position: 2, name: "Juridisch", item: "https://geldgarant.com/juridisch" },
            { "@type": "ListItem", position: 3, name: d.naam, item: url },
        ],
    },
]
---

<Base title={d.seoTitle} description={d.description} jsonLd={jsonLd} stickyCta={false}>
    <!-- alleen zichtbaar bij afdrukken en in de pdf -->
    <div class="print-kop" aria-hidden="true">
        <img src="/brand/full-logo-light.svg" alt="" width="1924" height="229" />
        <p>
            {site.street}, {`${site.postcode} ${site.city}`}
            <br />
            {site.phone} · {site.email} · geldgarant.com
            <br />
            KvK {site.kvk} · Incassoregister Justis {site.incassoRegister}
        </p>
    </div>

    <!-- HERO -->
    <section class="hero">
        <div class="wrap">
            <Crumbs items={[{ label: "Home", href: "/" }, { label: "Juridisch", href: "/juridisch" }, { label: d.naam }]} />
            <div class="hero-grid">
                <div class="hero-copy">
                    <p class="voor">{d.voor}</p>
                    <h1 class="display">
                        {d.h1[0].endsWith(" ") ? (
                            <Fragment>
                                {d.h1[0].trim()}
                                <br />
                                <span class="accent">{d.h1[1]}</span>
                            </Fragment>
                        ) : (
                            <Fragment set:html={`${d.h1[0]}&shy;<span class="accent">${d.h1[1]}</span>`} />
                        )}
                    </h1>
                    <p class="lead">{d.lead}</p>
                    <ul role="list" class="meta">
                        <li>
                            <Icon name="calendar" size={16} />
                            Versie {datum}
                        </li>
                        <li>
                            <Icon name="clock" size={16} />
                            {minuten} min lezen
                        </li>
                    </ul>
                    <div class="hero-actions">
                        <a class="btn" href="#tekst">
                            Lees de volledige tekst
                            <span class="btn-dot">
                                <Icon name="arrow" size={18} />
                            </span>
                        </a>
                        <a class="btn btn-ghost" href={pdfHref} download>
                            <Icon name="doc" size={18} />
                            Pdf, {pdf.paginas}
                            {"\u00a0"}pagina’s
                        </a>
                    </div>
                </div>
                <a class="papier" href={pdfHref} target="_blank" rel="noopener" aria-label={`${d.naam} openen als pdf`}>
                    <span class="papier-laag" aria-hidden="true"></span>
                    <span class="papier-laag" aria-hidden="true"></span>
                    <img
                        src={`/juridisch/${pdf.preview}`}
                        alt=""
                        width="600"
                        height="849"
                        fetchpriority="high"
                        decoding="async"
                    />
                    <span class="papier-knop" aria-hidden="true">
                        <Icon name="arrow-up-right" size={18} />
                    </span>
                </a>
            </div>
        </div>
    </section>

    <!-- IN HET KORT -->
    <section class="sam-sec" aria-labelledby="sam-title">
        <div class="wrap">
            <div class="sam bg-ink">
                <div class="sam-kop">
                    <h2 class="sam-title" id="sam-title">
                        In het <span class="accent">kort</span>
                    </h2>
                    <p>Een samenvatting in gewone taal. De volledige tekst hieronder is leidend.</p>
                </div>
                <ul role="list">
                    {d.kort.map((k) => (
                        <li>
                            <Icon name="check" size={18} />
                            <span>{k}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <!-- VOLLEDIGE TEKST + INHOUDSOPGAVE -->
    <section class="section tekst-sec" id="tekst" aria-label={`Volledige tekst ${d.naam}`}>
        <div class="wrap doc-grid">
            <details class="toc-mob">
                <summary>
                    <span>Inhoud</span>
                    <span class="toc-mob-n">
                        {koppen.length} {isAv ? "artikelen" : "onderdelen"}
                    </span>
                    <Icon name="chevron" size={18} />
                </summary>
                <ol role="list" class="toc-lijst">
                    {koppen.map((k, i) => (
                        <li>
                            <a href={`#${k.id}`}>
                                <span class="toc-n num">{i + 1}</span>
                                {k.tekst}
                            </a>
                        </li>
                    ))}
                </ol>
            </details>

            <article class={`prose juridisch${isAv ? " is-av" : ""}`}>
                <p class="print-titel">{d.naam}</p>
                <p class="print-versie">Versie {datum}</p>
                <Fragment set:html={html} />
            </article>

            <div class="zij">
                <nav class="toc" aria-labelledby="toc-title">
                    <p class="toc-title" id="toc-title">
                        Inhoud
                    </p>
                    <ol role="list" class="toc-lijst">
                        {koppen.map((k, i) => (
                            <li>
                                <a href={`#${k.id}`} data-toc={k.id}>
                                    <span class="toc-n num">{i + 1}</span>
                                    {k.tekst}
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
                <a class="zij-pdf" href={pdfHref} download>
                    <Icon name="doc" size={18} />
                    <span>
                        Download als pdf
                        <small>
                            {pdf.paginas} pagina’s, {pdf.kb}
                            {"\u00a0"}kB
                        </small>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <!-- VERDER -->
    <section class="section bg-surface verder-sec" aria-labelledby="verder-title">
        <div class="wrap">
            <div class="verder-kop">
                <h2 class="h2" id="verder-title">
                    Andere <span class="accent">documenten</span>
                </h2>
            </div>
            <div class="verder">
                <ul role="list" class="docs">
                    {anderen.map((a) => (
                        <li>
                            <a class="doc-kaart" href={a.href}>
                                <span class="doc-thumb" aria-hidden="true">
                                    <Icon name={a.icon} size={22} />
                                </span>
                                <span class="doc-tekst">
                                    <span class="doc-titel">{a.titel}</span>
                                    <span class="doc-voor">{a.tekst}</span>
                                </span>
                                <Icon name="arrow" size={18} />
                            </a>
                        </li>
                    ))}
                </ul>
                <aside class="vraag bg-ink" aria-labelledby="vraag-title">
                    {slug === "privacy-beleid" ? (
                        <Fragment>
                            <h3 class="vraag-kop" id="vraag-title">
                                Uw rechten uitoefenen
                            </h3>
                            <p>
                                Inzage, correctie of verwijdering van uw gegevens? Dien een verzoek in, dan reageren we binnen een
                                maand.
                            </p>
                            <a class="btn btn-light" href="/contact-opnemen?onderwerp=privacy_avg">
                                Verzoek indienen
                                <span class="btn-dot">
                                    <Icon name="arrow" size={18} />
                                </span>
                            </a>
                        </Fragment>
                    ) : (
                        <Fragment>
                            <h3 class="vraag-kop" id="vraag-title">
                                Vraag over een artikel?
                            </h3>
                            <p>Bel of mail ons. We leggen het u graag in gewone taal uit.</p>
                            <a class="btn btn-light" href={site.phoneHref}>
                                <Icon name="phone" size={18} />
                                Bel{"\u00a0"}
                                {site.phone}
                            </a>
                        </Fragment>
                    )}
                    <a class="textlink vraag-mail" href={`mailto:${site.email}`}>
                        {site.email}
                    </a>
                </aside>
            </div>
        </div>
    </section>
</Base>

<script>
    // Meelopende inhoudsopgave: het artikel dat bovenaan het scherm staat, krijgt aria-current.
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")]
    const koppen = links.map((l) => document.getElementById(l.dataset.toc!)).filter((k): k is HTMLElement => !!k)
    if (koppen.length && "IntersectionObserver" in window) {
        const zet = (id: string) => {
            for (const l of links) {
                if (l.dataset.toc === id) l.setAttribute("aria-current", "true")
                else l.removeAttribute("aria-current")
            }
        }
        let actief = ""
        const io = new IntersectionObserver(
            () => {
                const grens = 140
                let huidig = koppen[0].id
                for (const k of koppen) if (k.getBoundingClientRect().top - grens <= 0) huidig = k.id
                if (huidig !== actief) zet((actief = huidig))
            },
            { rootMargin: "-140px 0px -60% 0px", threshold: [0, 1] },
        )
        koppen.forEach((k) => io.observe(k))
    }
    // Mobiele inhoudsopgave sluiten na een keuze
    const mob = document.querySelector<HTMLDetailsElement>(".toc-mob")
    mob?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a")) mob.open = false
    })
</script>

<style>
    /* ---------- HERO ---------- */
    .hero {
        padding-block: clamp(20px, 3vw, 40px) clamp(48px, 6vw, 88px);
        overflow: hidden;
    }
    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(40px, 5vw, 72px);
        margin-top: clamp(24px, 3vw, 40px);
        /* start, niet center: anders schuift de tekst mee als het accentfont later laadt (CLS) */
        align-items: start;
    }
    @media (min-width: 900px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
        }
    }
    .voor {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--blue-soft);
        color: var(--blue-ink);
        font-size: var(--fs-xs);
        font-weight: 600;
    }
    .hero h1 {
        margin-top: 18px;
        hyphens: manual;
        font-size: clamp(2.375rem, 1.3rem + 4.2vw, 4.5rem);
    }
    .hero .lead {
        margin-top: 24px;
        max-width: 34em;
    }
    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
        margin-top: 24px;
        font-size: var(--fs-sm);
        color: var(--muted);
    }
    .meta li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .meta :global(svg) {
        color: var(--blue);
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
    }
    @media (max-width: 519px) {
        .hero-actions .btn {
            width: 100%;
        }
    }

    /* papier: echte eerste pagina van de pdf met twee lagen erachter */
    .papier {
        position: relative;
        display: block;
        /* ruimte rechts voor de gedraaide lagen, zodat ze nooit buiten het scherm steken */
        width: min(calc(100% - 48px), 320px);
        margin-inline: auto;
        aspect-ratio: 600 / 849;
        isolation: isolate;
    }
    @media (max-width: 899px) {
        .papier {
            display: none;
        }
    }
    .papier img,
    .papier-laag {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: 10px;
    }
    .papier img {
        z-index: 2;
        object-fit: cover;
        background: #fff;
        box-shadow:
            0 1px 2px rgba(6, 17, 38, 0.08),
            0 12px 32px rgba(6, 17, 38, 0.12),
            0 40px 80px rgba(6, 17, 38, 0.1);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .papier-laag {
        z-index: 1;
        background: #fff;
        border: 1px solid var(--line);
        transform: rotate(4deg) translate(10px, 6px);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .papier-laag + .papier-laag {
        z-index: 0;
        background: var(--surface);
        transform: rotate(8deg) translate(20px, 14px);
    }
    .papier-knop {
        position: absolute;
        z-index: 3;
        right: -14px;
        bottom: 28px;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: var(--blue);
        color: #fff;
        box-shadow: 0 8px 20px rgba(48, 105, 254, 0.35);
    }
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .papier:hover img {
            transform: translateY(-6px) rotate(-1deg);
        }
        .papier:hover .papier-laag {
            transform: rotate(6deg) translate(14px, 8px);
        }
    }
    .papier:focus-visible {
        outline: none;
    }
    .papier:focus-visible img {
        outline: 3px solid var(--blue);
        outline-offset: 4px;
    }

    /* ---------- IN HET KORT ---------- */
    .sam {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 24px 64px;
        padding: clamp(28px, 4vw, 56px);
        border-radius: var(--r-xl);
        color: rgba(255, 255, 255, 0.82);
    }
    @media (min-width: 1024px) {
        .sam {
            grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
        }
    }
    .sam-title {
        font-family: var(--font-display);
        font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: #fff;
    }
    .sam-kop p {
        margin-top: 12px;
        max-width: 22em;
        font-size: var(--fs-sm);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.68);
    }
    .sam ul {
        display: grid;
        gap: 14px;
    }
    .sam li {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 14px;
        align-items: start;
        line-height: 1.6;
    }
    .sam li :global(svg) {
        margin-top: 4px;
        color: #8fa9ff;
    }

    /* ---------- TEKST + INHOUDSOPGAVE ---------- */
    .doc-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 28px;
    }
    @media (min-width: 1080px) {
        .doc-grid {
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 80px;
            align-items: start;
        }
        .toc-mob {
            display: none;
        }
    }
    .juridisch {
        max-width: 46rem;
    }
    .tekst-sec {
        padding-top: clamp(48px, 6vw, 88px);
    }
    .print-titel,
    .print-versie,
    .print-kop {
        display: none;
    }
    /* de eerste kop volgt op de (verborgen) printtitel: geen extra witruimte erboven */
    .juridisch :global(h2:first-of-type) {
        margin-top: 0;
    }
    /* tabellen: op smalle schermen elke rij als kaart, met het kolomlabel boven elke waarde */
    @media screen and (max-width: 719px) {
        .juridisch :global(.tabel:has(.kaarttabel)) {
            overflow: visible;
            border: 0;
            border-radius: 0;
        }
        /* tabellen met twee kolommen passen op elk scherm: geen minimumbreedte en dus nooit zijwaarts scrollen */
        .juridisch :global(.tabel:not(:has(.kaarttabel)) table) {
            min-width: 0;
        }
        .juridisch :global(.kaarttabel),
        .juridisch :global(.kaarttabel tbody),
        .juridisch :global(.kaarttabel tr),
        .juridisch :global(.kaarttabel td) {
            display: block;
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
        }
        .juridisch :global(.kaarttabel thead),
        .juridisch :global(.kaarttabel thead tr),
        .juridisch :global(.kaarttabel thead th) {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
        .juridisch :global(.kaarttabel tbody tr) {
            padding: 6px 18px;
            border: 1px solid var(--line);
            border-radius: var(--r-lg);
            background: #fff;
        }
        .juridisch :global(.kaarttabel tbody tr + tr) {
            margin-top: 10px;
        }
        .juridisch :global(.kaarttabel td) {
            padding: 10px 0;
            border: 0;
        }
        .juridisch :global(.kaarttabel td + td) {
            border-top: 1px solid var(--line);
        }
        .juridisch :global(.kaarttabel td::before) {
            content: attr(data-label);
            display: block;
            margin-bottom: 2px;
            font-size: var(--fs-xs);
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
        }
        .juridisch :global(.kaarttabel td:first-child) {
            font-weight: 600;
            color: var(--ink);
        }
        .juridisch :global(.kaarttabel td:first-child::before) {
            display: none;
        }
    }
    .juridisch :global(.art-nr) {
        display: block;
        margin-bottom: 6px;
        font-family: var(--font-body);
        font-size: var(--fs-xs);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--blue-ink);
    }
    .juridisch :global(.lid) {
        position: relative;
    }
    .juridisch :global(.lid-nr) {
        margin-right: 6px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
        text-decoration: none;
    }
    .juridisch :global(.lid-nr:hover) {
        color: var(--blue-ink);
        text-decoration: underline;
    }
    .juridisch :global(.lid:target) {
        margin-inline: -14px;
        padding: 10px 14px;
        border-radius: 12px;
        background: var(--blue-soft);
    }
    .juridisch :global(td:first-child) {
        white-space: normal;
    }
    .is-av :global(.tabel td:first-child) {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .zij {
        display: none;
    }
    @media (min-width: 1080px) {
        .zij {
            position: sticky;
            top: 104px;
            display: grid;
            gap: 12px;
        }
    }
    /* korte schermen: de zijbalk mag nooit zelf scrollen, dan liever niet meelopen */
    @media (min-width: 1080px) and (max-height: 860px) {
        .zij {
            position: static;
        }
    }
    .toc {
        padding: 22px 12px 14px;
        border-radius: var(--r-lg);
        background: var(--surface);
    }
    .toc-title {
        padding-inline: 12px;
        font-size: var(--fs-xs);
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .toc-lijst {
        display: grid;
        margin-top: 8px;
    }
    .toc-lijst a {
        display: grid;
        grid-template-columns: 1.75rem minmax(0, 1fr);
        gap: 6px;
        align-items: center;
        min-height: 30px;
        padding: 3px 12px;
        border-radius: 10px;
        font-size: 0.875rem;
        line-height: 1.3;
        color: var(--text);
        transition:
            background 0.2s,
            color 0.2s;
    }
    .toc-lijst a:hover {
        color: var(--ink);
        background: rgba(255, 255, 255, 0.7);
    }
    .toc-lijst a[aria-current="true"] {
        background: #fff;
        color: var(--ink);
        font-weight: 600;
    }
    .toc-n {
        font-size: var(--fs-xs);
