---
import Base from "../layouts/Base.astro"
import Afrekening from "../components/Afrekening.astro"
import Proces from "../components/home/Proces.astro"
import Bento from "../components/home/Bento.astro"
import Kosten from "../components/home/Kosten.astro"
import Faq from "../components/Faq.astro"
import SlotCta from "../components/SlotCta.astro"
import Icon from "../components/Icon.astro"
import { getCollection } from "astro:content"
import { site, branches } from "../data/site"
import { onderwerpById } from "../data/kennisbank"
import { homeFaq } from "../data/faq"

const title = "Incassobureau voor ondernemers | GeldGarant"
const description =
    "Klant betaalt niet? GeldGarant neemt uw vordering binnen 1 uur in behandeling. Betaalt de debiteur volledig, dan betaalt u niets."

// Drie artikelen voor de kennisbankrij: het stappenplan en twee veelgezochte onderwerpen
const kennisSlugs = ["openstaande-factuur-stappenplan", "wettelijke-rente-2026", "debiteur-betwist-factuur"]
const kennis = await getCollection("kennisbank")
const latestArticles = kennisSlugs
    .map((slug) => kennis.find((a) => a.id === slug))
    .filter((a) => a !== undefined)
    .map((a) => ({
        title: a.data.title,
        slug: a.id,
        date: a.data.bijgewerkt.toISOString().slice(0, 10),
        cat: onderwerpById[a.data.onderwerp].label,
    }))
const fmtDate = (d: string) =>
    new Intl.DateTimeFormat("nl-NL", { day: "numeric", month: "long", year: "numeric" }).format(new Date(d))

const jsonLd = [
    {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": "https://geldgarant.com/#organisatie",
        name: "GeldGarant",
        url: "https://geldgarant.com",
        logo: "https://geldgarant.com/brand/icon-512.png",
        image: "https://geldgarant.com/brand/og-default.png",
        description:
            "Incassobureau voor ondernemers, met kantoor in Deventer. Incasso en debiteurenbeheer; bij volledige betaling betaalt u niets.",
        sameAs: [...site.sameAs, site.incassoRegisterHref],
        telephone: site.phoneIntl,
        email: site.email,
        areaServed: "NL",
        address: {
            "@type": "PostalAddress",
            streetAddress: site.street,
            postalCode: site.postcode,
            addressLocality: site.city,
            addressCountry: "NL",
        },
        openingHoursSpecification: [
            {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                opens: "09:00",
                closes: "17:00",
            },
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: homeFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
]

const diensten = [
    { t: "Incasso", d: "Eén onbetaalde factuur of tientallen: wij nemen het innen volledig van u over.", href: "/incasso" },
    {
        t: "Debiteurenbeheer",
        d: "Wij bewaken uw openstaande posten en sturen herinneringen, nog vóór het een incassozaak wordt.",
        href: "/debiteurenbeheer",
    },
    {
        t: "Vordering in het buitenland",
        d: "Klant over de grens? Ook dan zorgen we dat uw factuur wordt betaald.",
        href: "/incasso/incasso-in-het-buitenland",
    },
    {
        t: "Incassokosten berekenen",
        d: "Reken uit welke wettelijke incassokosten en rente u mag doorberekenen.",
        href: "/incasso/incassokosten-berekenen",
    },
]

const branchIcon = {
    "incasso-bouw": "building",
    "incasso-transport": "truck",
    "incasso-verhuur": "key",
    "incasso-automotive": "car",
    "incasso-groothandel": "box",
    "incasso-dienstverlening": "briefcase",
    "incasso-ecommerce": "cart",
    "incasso-zorg": "heart",
    "incasso-mkb": "store",
    "incasso-zzp": "person",
} as const
---

<Base title={title} description={description} jsonLd={jsonLd}>
    <!-- HERO -->
    <section class="hero">
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <a class="badge" href={site.incassoRegisterHref}>
                    <Icon name="shield" size={18} />
                    <span>
                        <span class="only-wide">Geregistreerd bij Justis · </span>Incassoregister
                        <span class="only-narrow"> Justis ·</span> {site.incassoRegister}
                    </span>
                </a>
                <h1 class="display">
                    Klant betaalt niet? Wij halen uw geld <span class="accent">wél</span> op.
                </h1>
                <p class="lead">
                    Betaalt de debiteur volledig, dan betaalt u ons niets: de wettelijke incassokosten zijn voor de debiteur. Wij
                    starten binnen 1 uur en u volgt elke stap online.
                </p>
                <div class="hero-actions">
                    <a class="btn" href="/vordering-indienen">
                        Vordering indienen
                        <span class="btn-dot">
                            <Icon name="arrow" size={18} />
                        </span>
                    </a>
                    <a class="btn btn-ghost" href={site.phoneHref}>
                        <Icon name="phone" size={18} />
                        Bel{" "}
                        {site.phone}
                    </a>
                </div>
                <ul role="list" class="hero-checks">
                    <li>
                        <Icon name="check" size={18} />
                        Geen abonnement
                    </li>
                    <li>
                        <Icon name="check" size={18} />
                        Ook voor één factuur
                    </li>
                    <li>
                        <Icon name="check" size={18} />
                        Wekelijks uitbetaald
                    </li>
                </ul>
            </div>

            <div class="hero-visual">
                <img class="hero-mark" src="/brand/short-logo-dark.svg" alt="" width="1220" height="1400" />
                <p class="hero-chip">
                    <span class="hero-chip-dot" aria-hidden="true"></span>
                    Binnen 1 uur in behandeling op werkdagen
                </p>
                <div class="hero-card">
                    <Afrekening />
                </div>
            </div>
        </div>
    </section>

    <Proces />
    <Bento />
    <Kosten />

    <!-- PERSOONLIJK -->
    <section class="section team-section" aria-labelledby="team-title">
        <div class="wrap team">
            <div class="photo-slot team-photo">
                <span>Foto kantoor Deventer volgt na de fotoshoot</span>
            </div>
            <div class="team-copy">
                <p class="eyebrow">
                    <span class="idx">04</span> Direct contact
                </p>
                <h2 class="h2" id="team-title">
                    Eén vast <span class="accent">aanspreekpunt</span> voor uw dossier
                </h2>
                <p class="lead">
                    Uw dossier ligt bij één vaste behandelaar. Die kent uw zaak, belt u terug en overlegt met u als een debiteur
                    een regeling wil.
                </p>
                <a class="textlink team-meer" href="/over-ons">
                    Meer over GeldGarant
                </a>
                <ul role="list" class="contact-list">
                    <li>
                        <a href={site.phoneHref}>
                            <span class="contact-icon">
                                <Icon name="phone" />
                            </span>
                            <span>
                                <strong>Bellen</strong>
                                {site.phone}
                            </span>
                        </a>
                    </li>
                    <li>
                        <a href={site.whatsappHref}>
                            <span class="contact-icon">
                                <Icon name="whatsapp" />
                            </span>
                            <span>
                                <strong>WhatsApp</strong>Stuur een bericht
                            </span>
                        </a>
                    </li>
                    <li>
                        <a href={`mailto:${site.email}`}>
                            <span class="contact-icon">
                                <Icon name="mail" />
                            </span>
                            <span>
                                <strong>E-mail</strong>
                                {site.email}
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- AANBOD -->
    <section class="section bg-surface" aria-labelledby="aanbod-title">
        <div class="wrap aanbod">
            <div class="aanbod-head">
                <p class="eyebrow">
                    <span class="idx">05</span> Diensten en branches
                </p>
                <h2 class="h2" id="aanbod-title">
                    Van één factuur tot uw hele <span class="accent">debiteurenbeheer</span>
                </h2>
            </div>
            <ul role="list" class="services">
                {diensten.map((d) => (
                    <li>
                        <a class="service" href={d.href}>
                            <span class="service-text">
                                <span class="service-title">{d.t}</span>
                                <span class="service-desc">{d.d}</span>
                            </span>
                            <span class="service-go" aria-hidden="true">
                                <Icon name="arrow-up-right" size={18} />
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
            <div class="branches-block">
                <h3 class="branches-title">Thuis in uw branche</h3>
                <ul role="list" class="branches" data-scroller>
                    {branches.map((b) => (
                        <li>
                            <a href={`/branches/${b.slug}`}>
                                <Icon name={branchIcon[b.slug as keyof typeof branchIcon]} size={18} />
                                {b.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <Faq items={homeFaq} idx="06" sectionId="veelgestelde-vragen" />

    <!-- KENNISBANK -->
    <section class="section" aria-labelledby="kennis-title">
        <div class="wrap">
            <div class="row-head">
                <div>
                    <p class="eyebrow">
                        <span class="idx">07</span> Kennisbank
                    </p>
                    <h2 class="h2" id="kennis-title">
                        Slimmer omgaan met <span class="accent">wanbetalers</span>
                    </h2>
                </div>
                <a class="textlink" href="/kennisbank">
                    Alle artikelen
                </a>
            </div>
            <ul role="list" class="articles" data-scroller>
                {latestArticles.map((a, i) => (
                    <li data-reveal style={`--d:${i}`}>
                        <a class="article" href={`/kennisbank/${a.slug}`}>
                            <div class="photo-slot article-img" aria-hidden="true"></div>
                            <p class="article-meta">
                                <span>{a.cat}</span>
                                <time datetime={a.date}>{fmtDate(a.date)}</time>
                            </p>
                            <h3 class="h3">{a.title}</h3>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <SlotCta lead="Dien uw vordering in ongeveer drie minuten in. Op werkdagen gaan we binnen het uur voor u aan de slag.">
        Laat uw geld niet langer <span class="accent">liggen</span>
    </SlotCta>
</Base>

<style>
    /* ---------- HERO ---------- */
    .hero {
        padding-block: clamp(28px, 4vw, 56px) clamp(48px, 6vw, 88px);
    }
    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(40px, 5vw, 72px);
        align-items: center;
    }
    @media (min-width: 1024px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        }
    }
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 40px;
        padding: 6px 16px 6px 10px;
        border-radius: var(--r-pill);
        background: var(--blue-soft);
        color: var(--ink);
        font-size: var(--fs-xs);
        font-weight: 500;
        transition: background-color 0.2s ease;
    }
    .badge:hover {
        background: #dfe7ff;
    }
    .badge :global(svg) {
        color: var(--blue);
        flex-shrink: 0;
    }
    .badge-sep {
        margin-inline: 4px;
        color: var(--muted);
    }
    .hero h1 {
        margin-top: 28px;
        max-width: 12.5em;
    }
    .hero .lead {
        margin-top: 28px;
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 40px;
    }
    .hero-checks {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 24px;
        margin-top: 36px;
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--ink);
    }
    .hero-checks li {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .hero-checks :global(svg) {
        color: var(--green);
    }
    @media (max-width: 519px) {
        .hero-actions .btn {
            width: 100%;
        }
    }

    /* Navy vlak is de container van de kaart: gelijke marges links, rechts en onder */
    .hero-visual {
        position: relative;
        overflow: hidden;
        padding: 52px 12px 12px;
        border-radius: var(--r-xl);
        background: var(--ink);
    }
    @media (min-width: 640px) {
        .hero-visual {
            padding: 60px 24px 24px;
        }
    }
    .hero-mark {
        position: absolute;
        right: 0;
        top: 0;
        width: 58%;
        height: auto;
        opacity: 0.06;
        pointer-events: none;
    }
    .hero-chip {
        position: absolute;
        top: 16px;
        left: 24px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 24px;
        color: #fff;
        font-size: var(--fs-xs);
        font-weight: 500;
    }
    @media (min-width: 640px) {
        .hero-chip {
            top: 20px;
            left: 32px;
        }
    }
    .hero-chip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #3ddc84;
        box-shadow: 0 0 0 4px rgba(61, 220, 132, 0.2);
    }
    .hero-card {
        position: relative;
    }

    /* ---------- gedeelde koppen ---------- */
    .row-head .h2 {
        margin-top: 14px;
    }
    .row-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px 48px;
        margin-bottom: clamp(40px, 5vw, 64px);
    }
    .row-head .lead {
        max-width: 30em;
    }

    /* ---------- PERSOONLIJK ---------- */
    .team {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
    }
    @media (min-width: 1024px) {
        .team {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 80px;
            align-items: center;
        }
    }
    .team-photo {
        aspect-ratio: 16 / 10;
    }
    @media (min-width: 1024px) {
        .team-photo {
            aspect-ratio: 5 / 4;
        }
    }
    .team-copy .h2 {
        margin-top: 14px;
    }
    .team-copy .lead {
        margin-top: 20px;
    }
    .team-meer {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: 8px;
        font-weight: 600;
    }
    .contact-list {
        display: grid;
        gap: 10px;
        margin-top: 32px;
    }
    .contact-list a {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 20px 12px 12px;
        border-radius: var(--r-pill);
        border: 1px solid var(--line);
        transition:
            border-color 0.2s ease,
            background-color 0.2s ease;
    }
    .contact-list a:hover {
        border-color: var(--blue);
        background: var(--blue-soft);
    }
    .contact-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--blue-soft);
        color: var(--blue);
    }
    .contact-list strong {
        display: block;
        color: var(--ink);
        font-weight: 600;
    }
    .contact-list a > span:last-child {
        font-size: var(--fs-sm);
        color: var(--muted);
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    /* ---------- AANBOD: diensten als rijen, branches als veegrij ---------- */
    .aanbod-head {
        max-width: 44rem;
        margin-bottom: clamp(28px, 4vw, 48px);
    }
    .aanbod-head .h2 {
        margin-top: 14px;
    }
    .services {
        display: grid;
        gap: 8px;
    }
    @media (min-width: 900px) {
        .services {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }
    }
    .service {
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        padding: 18px 16px 18px 22px;
        border-radius: var(--r-lg);
        background: #fff;
        transition: box-shadow 0.25s var(--ease);
    }
    .service:hover {
        box-shadow: var(--shadow-card);
    }
    .service-text {
        display: grid;
        gap: 2px;
        flex: 1;
        min-width: 0;
    }
    .service-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.125rem;
        letter-spacing: -0.015em;
        color: var(--ink);
    }
    .service-desc {
        font-size: var(--fs-sm);
        color: var(--muted);
        line-height: 1.5;
    }
    .service-go {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--blue);
        color: #fff;
        transition: transform 0.25s var(--ease);
    }
    .service:hover .service-go {
        transform: rotate(45deg);
    }
    .branches-block {
        margin-top: clamp(32px, 4vw, 48px);
    }
    .branches-title {
        font-family: var(--font-body);
        font-size: var(--fs-sm);
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 12px;
    }
    .branches {
        display: flex;
        gap: 8px;
        margin-inline: calc(-1 * var(--gutter));
        padding: 0 var(--gutter) 4px;
        overflow-x: auto;
        scrollbar-width: none;
    }
    .branches::-webkit-scrollbar {
        display: none;
    }
    @media (min-width: 900px) {
        .branches {
            flex-wrap: wrap;
            margin-inline: 0;
            padding: 0;
            overflow: visible;
        }
    }
    .branches li {
        flex-shrink: 0;
    }
    .branches a {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        padding: 0 18px 0 14px;
        border-radius: var(--r-pill);
        background: #fff;
        font-size: var(--fs-sm);
        font-weight: 500;
        color: var(--ink);
        white-space: nowrap;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }
    .branches a:hover {
        background: var(--ink);
        color: #fff;
    }
    .branches :global(svg) {
        color: var(--blue);
    }
    .branches a:hover :global(svg) {
        color: var(--blue-on-dark);
    }

    /* ---------- KENNISBANK: veegrij op mobiel ---------- */
    .articles {
        display: flex;
        gap: 16px;
        margin-inline: calc(-1 * var(--gutter));
        padding: 0 var(--gutter) 4px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--gutter);
        scrollbar-width: none;
    }
    .articles::-webkit-scrollbar {
        display: none;
    }
    .articles li {
        flex: 0 0 min(78%, 320px);
        scroll-snap-align: start;
    }
    @media (min-width: 720px) {
        .articles {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            margin-inline: 0;
            padding: 0;
            overflow: visible;
        }
    }
    .article {
        display: block;
    }
    .article-img {
        aspect-ratio: 16 / 10;
        border-radius: var(--r-lg);
        transition: transform 0.4s var(--ease);
    }
    .article:hover .article-img {
        transform: scale(0.985);
    }
    .article-meta {
        display: flex;
        gap: 12px;
        margin-top: 16px;
        font-size: var(--fs-xs);
        color: var(--muted);
    }
    .article-meta span {
        color: var(--blue-ink);
        font-weight: 600;
    }
    .article .h3 {
        margin-top: 6px;
        font-size: 1.125rem;
        transition: color 0.2s ease;
    }
    .article:hover .h3 {
        color: var(--blue-ink);
    }
</style>
