---
// Formulierveld met label, optionele hint en een foutregel die het script vult (id `${id}-fout`).
// `name` is het pad in de formulierstatus, bv. "debiteur_adres.postcode".
import type { HTMLAttributes } from "astro/types"

interface Props {
    id: string
    name: string
    label: string
    type?: "text" | "email" | "tel" | "date"
    required?: boolean
    optioneel?: boolean
    hint?: string
    autocomplete?: HTMLAttributes<"input">["autocomplete"]
    inputmode?: HTMLAttributes<"input">["inputmode"]
    placeholder?: string
    maxlength?: number
    breed?: boolean
    /** Vast teken vóór de invoer, bv. "€" (alleen visueel; het label noemt de eenheid). */
    prefix?: string
}
const {
    id,
    name,
    label,
    type = "text",
    required = false,
    optioneel = false,
    hint,
    autocomplete,
    inputmode,
    placeholder,
    maxlength = 200,
    breed = false,
    prefix,
} = Astro.props
const describedby = [hint ? `${id}-hint` : null, `${id}-fout`].filter(Boolean).join(" ")
---

<div class:list={["veld", { breed }]} data-veld={name}>
    <label for={id}>
        {label}
        {optioneel && <span class="veld-opt">optioneel</span>}
    </label>
    {prefix ? (
        <div class="veld-prefix">
            <span aria-hidden="true">{prefix}</span>
            <input
                id={id}
                name={name}
                type={type}
                required={required}
                autocomplete={autocomplete}
                inputmode={inputmode}
                placeholder={placeholder}
                maxlength={type === "date" ? undefined : maxlength}
                aria-describedby={describedby}
                data-bind={name}
            />
        </div>
    ) : (
        <input
            id={id}
            name={name}
            type={type}
            required={required}
            autocomplete={autocomplete}
            inputmode={inputmode}
            placeholder={placeholder}
            maxlength={type === "date" ? undefined : maxlength}
            aria-describedby={describedby}
            data-bind={name}
        />
    )}
    {hint && (
        <p class="veld-hint" id={`${id}-hint`}>
            {hint}
        </p>
    )}
    <p class="veld-fout" id={`${id}-fout`} data-fout={name}></p>
</div>
