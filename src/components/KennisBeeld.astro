---
// Illustratie bij een kennisbankartikel (navy vlak, wit icoon met blauw accent). Decoratief: de kaart heeft zelf de titel.
// Iconen en combinaties per artikel: src/lib/kennisbeeld.ts. Pijlbol rechtsonder zoals de knoppen (.btn-dot).
import Icon from "./Icon.astro"
import { beeldVoor } from "../lib/kennisbeeld"

interface Props {
    slug: string
    class?: string
}

const { slug, class: klasse } = Astro.props
const svg = beeldVoor(slug)
---

<div class:list={["kb-beeld", klasse]} aria-hidden="true">
    <Fragment set:html={svg} />
    <span class="kb-beeld-pijl">
        <Icon name="arrow-up-right" size={16} />
    </span>
</div>

<style>
    .kb-beeld {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: var(--r-lg);
        background:
            radial-gradient(circle at 50% 50%, rgba(48, 105, 254, 0.3), transparent 62%),
            radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.4px) 0 0 / 14px 14px,
            var(--ink);
    }
    .kb-beeld :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        transition: transform 0.4s var(--ease);
    }
    .kb-beeld-pijl {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        transition: background-color 0.2s ease;
    }
    :global(.kaart) .kb-beeld {
        border-radius: var(--r-md);
    }
    :global(a:hover) .kb-beeld :global(svg) {
        transform: scale(1.04);
    }
    :global(a:hover) .kb-beeld-pijl {
        background: var(--blue);
    }
    @media (prefers-reduced-motion: reduce) {
        .kb-beeld :global(svg) {
            transition: none;
        }
        :global(a:hover) .kb-beeld :global(svg) {
            transform: none;
        }
    }
</style>
