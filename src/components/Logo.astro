---
// Officieel GeldGarant-logo (bron: aangeleverde SVG's, gecropt en transparant in /public/brand)
interface Props {
    variant?: "light" | "dark"
    height?: number
}
const { variant = "light", height = 30 } = Astro.props
// height = dezelfde maat als bij het oude logo (1896 × 304, incl. staart van de kleine g).
// Het gecorrigeerde logo (1924 × 228,5) heeft geen onderstok meer; zo blijft het even groot.
const imgHeight = Math.round((height * 228.5) / 304)
const width = Math.round((1924 / 228.5) * imgHeight)
---

<a href="/" class="logo" aria-label="GeldGarant, naar de homepage">
    <img src={`/brand/full-logo-${variant}.svg`} alt="" width={width} height={imgHeight} />
</a>

<style>
    .logo {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        flex-shrink: 0;
    }
    .logo img {
        height: auto;
    }
</style>
