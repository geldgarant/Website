---
// Veelgestelde vragen: kop links (sticky op desktop), uitklappers rechts. Gebruikt op home en dienstpagina's.
import Icon from "./Icon.astro"
import { site } from "../data/site"
import Foto from "./Foto.astro"
import type { ImageMetadata } from "astro"
// vier gezichten uit de eigen shoot (uitsneden in src/assets/fotos/gezichten)
// studioportretten, volgorde via de bestandsnaam (1-man, 2-vrouw, 3-man, 4-vrouw)
const gezichten = Object.entries(import.meta.glob<{ default: ImageMetadata }>("../assets/fotos/gezichten/*.jpg", { eager: true }))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, m]) => m.default)

interface Props {
    items: readonly { q: string; a: string }[]
    idx?: string
    id?: string
    // optioneel id op de sectie zelf, als ankerdoel (bijv. vanuit een inhoudsopgave)
    sectionId?: string
}
const { items, idx, id = "faq-title", sectionId } = Astro.props
---

<section class="section bg-surface" aria-labelledby={id} id={sectionId}>
    <div class="wrap split">
        <div class="split-head">
            <p class="eyebrow">{idx && <span class="idx">{idx}</span>} Veelgestelde vragen</p>
            <h2 class="h2" id={id}>
                <slot name="title">
                    Goed om te <span class="accent">weten</span>
                </slot>
            </h2>
            <div class="ask">
                <div class="ask-kop">
                    <span class="ask-gezichten" aria-hidden="true">
                        {gezichten.map((g) => (
                            <span class="ask-gezicht">
                                <Foto src={g} alt="" sizes="48px" widths={[96, 144]} />
                            </span>
                        ))}
                    </span>
                    <p>
                        <strong>Staat uw vraag er niet tussen?</strong> Bel ons, we helpen u direct verder.
                    </p>
                </div>
                <div class="ask-acties">
                    <a class="btn btn-dark" href={site.phoneHref}>
                        Bel{"\u00a0"}
                        {site.phone}
                        <span class="btn-dot">
                            <Icon name="phone" size={18} />
                        </span>
                    </a>
                    <a class="btn btn-ghost" href={site.whatsappHref} target="_blank" rel="noopener">
                        <Icon name="whatsapp" size={18} />
                        WhatsApp
                    </a>
                </div>
            </div>
        </div>
        <div class="faq">
            {items.map((f) => (
                <details class="faq-item">
                    <summary>
                        <span>{f.q}</span>
                        <span class="faq-icon" aria-hidden="true">
                            <Icon name="plus" size={18} />
                        </span>
                    </summary>
                    <p>{f.a}</p>
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    .split {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 40px;
    }
    @media (min-width: 1024px) {
        .split {
            grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
            gap: 72px;
            align-items: start;
        }
        .split-head {
            position: sticky;
            top: calc(var(--header-h) + 40px);
        }
    }
    .split-head .h2 {
        margin-top: 14px;
        -webkit-hyphens: auto;
        hyphens: auto;
        hyphenate-limit-chars: 14 6 6;
    }
    .ask {
        margin-top: 32px;
        padding: 24px;
        border-radius: var(--r-lg);
        background: #fff;
    }
    .ask p {
        color: var(--muted);
        font-size: var(--fs-sm);
    }
    .ask strong {
        display: block;
        color: var(--ink);
        font-size: 1rem;
        margin-bottom: 4px;
    }
    .ask-kop {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 16px;
    }
    .ask-kop p {
        flex: 1 1 200px;
    }
    .ask-gezichten {
        display: flex;
        flex: none;
    }
    .ask-gezicht {
        width: 48px;
        height: 48px;
        overflow: hidden;
        border: 3px solid #fff;
        border-radius: 50%;
        background: var(--surface);
    }
    .ask-gezicht + .ask-gezicht {
        margin-left: -12px;
    }
    .ask-acties {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }
    .faq {
        display: grid;
        gap: 8px;
    }
    .faq-item {
        border-radius: var(--r-md);
        background: #fff;
        transition: box-shadow 0.2s ease;
    }
    .faq-item[open] {
        box-shadow: var(--shadow-card);
    }
    .faq-item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 64px;
        padding: 16px 16px 16px 24px;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.0625rem;
        letter-spacing: -0.01em;
        overflow-wrap: anywhere;
        color: var(--ink);
        cursor: pointer;
        list-style: none;
    }
    .faq-item summary::-webkit-details-marker {
        display: none;
    }
    .faq-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--surface);
        color: var(--ink);
        transition:
            transform 0.25s var(--ease),
            background-color 0.2s ease;
    }
    .faq-item[open] .faq-icon {
        transform: rotate(45deg);
        background: var(--blue);
        color: #fff;
    }
    .faq-item p {
        padding: 0 24px 24px;
        color: var(--muted);
        max-width: 44em;
    }
</style>
