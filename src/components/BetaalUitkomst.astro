---
// Terugkeerpagina na een online betaling (/brief-ontvangen/bedankt en /mislukt). Beide noindex en niet in de sitemap.
// Werkt pas als in CaseControl (of bij de betaalprovider) de terugkeer-URL op deze pagina's staat; vraag bij Anas uit.
import Base from "../layouts/Base.astro"
import Icon from "./Icon.astro"
import { site } from "../data/site"

interface Props {
    soort: "bedankt" | "mislukt"
}
const { soort } = Astro.props
const goed = soort === "bedankt"
const title = goed ? "Bedankt voor uw betaling | GeldGarant" : "Betaling niet gelukt | GeldGarant"
const description = goed
    ? "Uw betaling aan GeldGarant is gestart. Zodra hij binnen is, verwerken we hem in uw dossier."
    : "Uw betaling aan GeldGarant is niet afgerond. Probeer het opnieuw of neem contact met ons op."
---

<Base title={title} description={description} noindex stickyCta={false}>
    <section class="uitkomst">
        <div class="wrap">
            <div class="kaart">
                <span class:list={["icoon", { goed }]} aria-hidden="true">
                    <Icon name={goed ? "check" : "clock"} size={30} />
                </span>
                {goed ? (
                    <h1 class="h2">
                        Bedankt voor uw <span class="accent">betaling</span>
                    </h1>
                ) : (
                    <h1 class="h2">
                        Uw betaling is niet <span class="accent">afgerond</span>
                    </h1>
                )}
                {goed ? (
                    <p class="lead">
                        Zodra de betaling bij ons binnen is, verwerken we hem in uw dossier. Heeft u het hele bedrag betaald, dan
                        hoeft u verder niets te doen. Betaalde u een deel, dan hoort u van ons wat er nog openstaat.
                    </p>
                ) : (
                    <p class="lead">
                        Dat kan gebeuren als de betaling is geannuleerd of te lang duurde. Er is dan niets afgeschreven. Probeer
                        het opnieuw, of neem contact met ons op als het niet lukt.
                    </p>
                )}
                <div class="acties">
                    {goed ? (
                        <a class="btn" href="/">
                            Naar de homepage
                            <span class="btn-dot">
                                <Icon name="arrow" size={18} />
                            </span>
                        </a>
                    ) : (
                        <a class="btn" href="/brief-ontvangen#betalen">
                            Opnieuw proberen
                            <span class="btn-dot">
                                <Icon name="arrow" size={18} />
                            </span>
                        </a>
                    )}
                    <a class="btn btn-ghost" href={site.phoneHref}>
                        Bel{"\u00a0"}
                        {site.phone}
                    </a>
                </div>
                <p class="noot">
                    Vragen over uw dossier? Mail{" "}
                    <a class="textlink" href={`mailto:${site.email}`}>
                        {site.email}
                    </a>{" "}
                    en vermeld uw dossiernummer. Wij zijn bereikbaar op {site.hours}.
                </p>
            </div>
        </div>
    </section>
</Base>

<style>
    .uitkomst {
        padding-block: clamp(40px, 6vw, 96px) clamp(64px, 8vw, 128px);
    }
    .kaart {
        max-width: 44rem;
        margin-inline: auto;
        padding: clamp(28px, 5vw, 56px);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        background: #fff;
        box-shadow: var(--shadow-card);
        text-align: center;
    }
    .icoon {
        display: inline-grid;
        place-items: center;
        width: 64px;
        height: 64px;
        margin-bottom: 20px;
        border-radius: 50%;
        background: #fff4e0;
        color: var(--amber);
    }
    .icoon.goed {
        background: var(--green-bg);
        color: var(--green);
    }
    .lead {
        margin: 18px auto 0;
        max-width: 34em;
    }
    .acties {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 32px;
    }
    @media (max-width: 519px) {
        .acties .btn {
            width: 100%;
        }
    }
    .noot {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--line);
        font-size: var(--fs-sm);
        color: var(--muted);
        line-height: 1.6;
    }
</style>
