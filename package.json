{
    "name": "geldgarant-site",
    "version": "1.0.0",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "check": "astro check",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:unit": "vitest run",
        "test:e2e": "playwright test --grep-invert @visueel",
        "test:visual": "playwright test --grep @visueel",
        "check:html": "html-validate \"dist/**/*.html\"",
        "check:links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\\\.0\\\\.0\\\\.1)\" --verbosity error",
        "check:seo": "node scripts/check-seo.mjs",
        "lhci": "lhci autorun",
        "audit:deps": "npm audit --omit=dev --audit-level=high",
        "qa": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run check:html && npm run check:seo && npm run test:e2e && npm run audit:deps",
        "qa:release": "npm run qa && npm run check:links && npm run lhci"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@fontsource-variable/schibsted-grotesk": "^5.3.0",
        "astro": "^7.4.7"
    },
    "type": "module",
    "private": true,
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@fontsource/poppins": "^5.3.0",
        "@lhci/cli": "^0.16.0",
        "@playwright/test": "^1.65.0",
        "eslint": "^10.14.0",
        "eslint-plugin-astro": "^3.2.1",
        "globals": "^17.14.0",
        "html-validate": "^11.18.0",
        "linkinator": "^8.1.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    }
}
